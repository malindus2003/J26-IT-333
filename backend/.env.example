# ==============================================================================
# SLIIT Research Project J26-IT-333: Environment Configuration
# ==============================================================================

# Firebase Realtime Database Configuration (Component 3: Food Spoilage & IoT Telemetry)
# Obtain this URL from Firebase Console -> Realtime Database -> Data tab (e.g., https://your-app-default-rtdb.firebaseio.com/)
FIREBASE_DATABASE_URL=https://smart-restaurant-j26-default-rtdb.firebaseio.com/

# Path to the downloaded service account key JSON file from Firebase Console:
# (Project Settings -> Service Accounts -> Generate new private key)
FIREBASE_CREDENTIALS_PATH=firebase_service_account.json

# API Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Smart Waste Bin: quotation email delivery (Component 4)
WASTE_FULL_BIN_THRESHOLD_PERCENT=90
WASTE_BIN_EMPTY_THRESHOLD_PERCENT=10
RECYCLING_COMPANY_EMAILS=Green Cycle <quotes@greencycle.example>,Paper Recovery <collections@paperrecovery.example>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=restaurant@example.com
SMTP_PASSWORD=replace-with-an-app-password
SMTP_FROM_EMAIL=restaurant@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
