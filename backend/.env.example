# Smart Waste Bin: quotation email delivery
WASTE_FULL_BIN_THRESHOLD_PERCENT=90
WASTE_BIN_EMPTY_THRESHOLD_PERCENT=10
# Addresses listed here are treated as accepting both Plastic and Paper.
# Use the dashboard registration form to save waste-type-specific companies.
RECYCLING_COMPANY_EMAILS=Green Cycle <quotes@greencycle.example>,Paper Recovery <collections@paperrecovery.example>

# SMTP server credentials. Use an app password when your provider requires one.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=restaurant@example.com
SMTP_PASSWORD=replace-with-an-app-password
SMTP_FROM_EMAIL=restaurant@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
